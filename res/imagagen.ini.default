# imagagen configuration
#
# [imagagen]
#   primary-gpu  GPU index to use for generation, or "auto" (default):
#                pick the non-ignored GPU with the most free VRAM.
#   ignore-gpus  comma-separated GPU indices to ignore (excluded from
#                auto-pick and from /api/health). Use this instead of
#                CUDA_VISIBLE_DEVICES.
#
#   VRAM options (all default off -- full quality, ~6.6 GiB at 768²):
#
#   unet-quantization   off (default) | nf4
#                nf4: 4-bit (bitsandbytes NF4) UNet weights. Saves ~3.2 GiB
#                VRAM (768² peak 6.6 -> 3.2 GiB) at the same speed. Output
#                is usable but softer than fp16 (quantization error).
#   text-encoder-device gpu (default) | cpu
#                cpu: keep the CLIP text encoders in system RAM. Saves
#                ~1.4 GiB VRAM permanently; costs ~1 s per generation
#                (CPU fp16 encoding is ~0.6 s per prompt). No quality loss.
#   vae-tiling          false (default) | true
#                true: force tiled VAE decode/encode at every size.
#                false (default): automatic -- tiled for images above
#                ~4 MP (the untiled path allocates full-resolution fp32
#                conv buffers and OOMs on a 16 GB card past ~5 MP; at
#                3440x1440 tiling is faster, peaks 7.4 vs 13.3 GiB, and
#                differs by <= 1/255 per pixel), untiled below that.
#                Tile-seam quality risk is negligible in practice.
#
#   Misc:
#   save-ui-state       true (default) | false
#                false: never write <root>/ui-state.json (the UI's
#                saved form inputs are not persisted). An existing
#                file is still loaded on start.
#
#   Speed (VRAM residency after/before a generation):
#   transformer-parking-delay  90 (default, seconds)
#                Seconds the queue waits after going idle before parking
#                the loaded model out of VRAM into RAM. Keeps the model
#                warm for follow-up generations (re-run = no reload).
#                0: park immediately (previous behavior); -1: never park
#                explicitly (the model stays resident until something
#                else needs the VRAM, e.g. a text encode swap or a model
#                switch).
#   prefetch-text-encoder      true (default) | false
#                true: when the UI's prompt changes and the final prompt
#                would MISS the prompt-encoding cache (always true for
#                wildcard prompts), immediately switch the GPU to its
#                "about to encode" layout: text encoders to VRAM, the
#                transformer parked to RAM if the two cannot co-reside
#                (SDXL's always fit, so its UNet stays put). The bus swap
#                then happens while you keep typing instead of at
#                Generate time. Ignores transformer-parking-delay; a
#                model that is already parked stays parked (nothing is
#                loaded for a prompt alone).
#
#   Combined (all three on): 1024² generation peaks at ~4.3 GiB and runs
#   in ~14 s -- SDXL fits on a 6 GB card or shares a GPU with a large LLM.
#
#   Development:
#   debug               false (default) | true
#                Disable browser caching entirely (Cache-Control: no-store
#                on every response). Without it, responses are revalidated
#                on each request (no-cache), which is normally enough --
#                but if the browser ever serves a stale app.js, flip this
#                on while developing and it is guaranteed fresh.
#   memory-debug        false (default) | true
#                Memory-leak tracing (see src/imagagen/memdbg.py). Every
#                multi-GiB model move -- park, restore, checkpoint load,
#                prompt prefetch, the parking timer, job lifecycle -- is
#                logged with the process RSS/swap, a sampler thread prints
#                RSS every memory-debug-interval seconds, and a full object
#                census (who owns how many bytes, per backend copy) runs
#                periodically, whenever RSS jumps, and on demand via
#                GET /api/memdbg. Everything is mirrored to user/memdbg.log.
#                Costs a few seconds of CPU per census; keep it off normally.
#   memory-debug-interval  30 (default, seconds)
#                Spacing of the sampler lines when memory-debug is on.
[imagagen]
primary-gpu = auto
ignore-gpus =
#unet-quantization = off
#text-encoder-device = gpu
#vae-tiling = false
#save-ui-state = true
#debug = false
#transformer-parking-delay = 90
#prefetch-text-encoder = true
#memory-debug = false
#memory-debug-interval = 30
